<comment>
problem = BE collapse laptop sanity test

<job>
problem_id = collapse_be

<problem/collapse_be>
mass        = 6.0
temperature = 10.0
f           = 5.0
rhocrit     = 1.0e-13
amp         = 0.0
omegatff    = 0.02

<parthenon/mesh>
refinement = adaptive
numlevel   = 3
multigrid  = true

nx1    = 32
x1min  = -26.0
x1max  =  26.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 32
x2min  = -26.0
x2max  =  26.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 32
x3min  = -26.0
x3max  =  26.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 2.0
nlim       = 1000

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-6
pfloor         = 1.0e-8

<refinement>
type = maxdensity
maxdensity_refine_above = 10.0
maxdensity_deref_below  = 5.0

<physics>
self_gravity = true

<self_gravity>
units_override = true
four_pi_G      = 1.0
use_swindle    = false
ix1_bc         = zero
ox1_bc         = zero
ix2_bc         = zero
ox2_bc         = zero
ix3_bc         = zero
ox3_bc         = zero

<self_gravity/solver_params>
max_iterations               = 200
residual_tolerance           = 1.0e-10
absolute_residual_tolerance  = 1.0e-10
relative_residual            = true
relative_residual_tolerance  = 1.0e-6
preconditioner               = Multigrid

<parthenon/output0>
file_type = hdf5
dt        = 0.05
variables = prim, grav.phi, grav.rhs

<parthenon/output1>
file_type = hst
dt        = 0.01

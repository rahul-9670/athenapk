<comment>
problem = 1D oblique MHD shock tube for ambipolar diffusion (C-shock) validation

<job>
problem_id = cshock

<problem/cshock>
xshock = 0.0      # location of the initial discontinuity
bx     = 1.0      # uniform normal field component (constant for div(B)=0 in 1D)
# Left (upstream) state
dl  = 1.0
vxl = 5.0
vyl = 0.0
vzl = 0.0
byl = 1.0
bzl = 0.0
pl  = 1.0
# Right (downstream) state
dr  = 3.0
vxr = 1.6666666667
vyr = 0.0
vzr = 0.0
byr = 3.0
bzr = 0.0
pr  = 16.0

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 256
x1min = -3.0
x1max = 3.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 256
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 2.0
nlim = 1000000

<hydro>
fluid = glmmhd
riemann = hlld
eos = adiabatic
reconstruction = plm
gamma = 2.0      # use a value close to 1 (e.g. 1.01) to approximate an isothermal C-shock

<diffusion>
integrator = unsplit          # ambipolar works with rkl2 too; unsplit kept for clarity
cfl = 0.3
ambipolar = ambipolar         # none (disabled) or ambipolar
ambipolar_coeff = fixed
ambipolar_coeff_code = 0.5    # Q_A : eta_A = Q_A * B^2 ; larger -> wider C-shock
# Optional: add Ohmic resistivity and/or Hall (Hall requires integrator=unsplit)
# resistivity = ohmic
# resistivity_coeff = fixed
# ohm_diff_coeff_code = 0.01
# hall = hall
# hall_coeff = fixed
# hall_coeff_code = 0.1
# hall_ohmic_floor_code = 0.0

<parthenon/output0>
file_type = hdf5
dt = 0.2
variables = prim
id = prim

<comment>
problem  = MHD BE collapse - test5-equivalent production run
based_on = Athena++ test5 (athinput.no_rad), parameters matched exactly
notes    = uses glmmhd_source = dedner_extended (fix from cooling investigation)
warning  = may stall at peak collapse like test5 itself did at t=1.02

<job>
problem_id = collapse_be

<problem/collapse_be>
mass        = 6.0
temperature = 10.0
f           = 5.0
rhocrit     = 1.0e-13
amp         = 0.0
omegatff    = 0.02
B0z         = 0.2392

<parthenon/mesh>
refinement = adaptive
numlevel   = 16
multigrid  = true

nx1    = 128
x1min  = -6.0
x1max  =  6.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 128
x2min  = -6.0
x2max  =  6.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 128
x3min  = -6.0
x3max  =  6.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 3.0
nlim       = 5000000

<hydro>
fluid          = glmmhd
eos            = adiabatic
gamma          = 1.4
riemann        = hlld
reconstruction = plm
glmmhd_source  = dedner_extended
dfloor         = 1.0e-6
pfloor         = 1.0e-8

<refinement>
type   = jeans
njeans = 16

<physics>
self_gravity = true

<self_gravity>
units_override = true
four_pi_G      = 1.0
use_swindle    = false
ix1_bc         = zero
ox1_bc         = zero
ix2_bc         = zero
ox2_bc         = zero
ix3_bc         = zero
ox3_bc         = zero

<self_gravity/solver_params>
max_iterations               = 200
residual_tolerance           = 1.0e-10
absolute_residual_tolerance  = 1.0e-10
relative_residual            = true
relative_residual_tolerance  = 1.0e-6
preconditioner               = Multigrid

<parthenon/output0>
file_type = hdf5
dt        = 0.01
variables = prim, grav.phi

<parthenon/output1>
file_type = hst
dt        = 0.001

<parthenon/output2>
file_type = rst
dt        = 0.05

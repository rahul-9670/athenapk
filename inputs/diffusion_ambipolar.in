<comment>
problem = Ambipolar diffusion damped-Alfven eigenmode decay test (quantitative)

<job>
problem_id = diffusion

<problem/diffusion>
iprob = 50      # ambipolar diffusion of a 1D sinusoidal transverse field
Bx    = 1.0     # uniform guide field B0 along x
By    = 0.0     # (unused for iprob=50)
amp   = 1.0e-6  # initial amplitude of By = amp*sin(k x); small -> linear regime
nwave = 1.0     # number of wavelengths across the (x1) domain

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic

nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.01
nlim = 10000000

<hydro>
fluid = glmmhd
riemann = hlld
eos = adiabatic
reconstruction = plm
gamma = 2.0

<diffusion>
integrator = unsplit          # explicit so the measured decay is unambiguous
cfl = 0.3
ambipolar = ambipolar
ambipolar_coeff = fixed
ambipolar_coeff_code = 5.0    # Q_A : eta_A = Q_A * B0^2 ; large -> overdamped (clean decay)

<parthenon/output0>
file_type = hdf5
dt = 0.01
variables = prim
id = prim

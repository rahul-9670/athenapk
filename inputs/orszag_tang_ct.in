<job>
problem_id = orszag_tang

<parthenon/mesh>
refinement = none
nghost = 3
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 128
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 128
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.4
tlim = 0.5
nlim = 200
perf_cycle_offset = 2

<hydro>
fluid = glmmhd
eos = adiabatic
riemann = hlld
reconstruction = ppm
gamma = 1.666666666666667
first_order_flux_correct = true
divergence_control = ct

<parthenon/output1>
file_type = hst
dt = 0.02

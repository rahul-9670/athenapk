<comment>
problem = Jeans dispersion, STABLE regime, adaptive AMR test
# Sound wave propagates through box, crests trigger refinement, troughs don't.
# This exercises refine+derefine as the wave moves.

<job>
problem_id = jeans

<problem/jeans>
rho0  = 1.0
cs    = 1.0
amp   = 1.0e-3
nwave = 1

<parthenon/mesh>
refinement = adaptive
numlevel   = 2
multigrid  = true

nx1    = 128
x1min  = 0.0
x1max  = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 4
x2min  = 0.0
x2max  = 0.03125
ix2_bc = periodic
ox2_bc = periodic

nx3    = 4
x3min  = 0.0
x3max  = 0.03125
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 4
nx3 = 4

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 4.0
nlim       = -1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.666667
riemann        = hllc
reconstruction = plm

<refinement>
# Wave amplitude is ~1e-3; set thresholds so crests refine and troughs don't.
# As the wave propagates, refined blocks move with it.
type     = maxdensity
maxdensity_refine_above = 1.0005
maxdensity_deref_below  = 1.0001

<physics>
self_gravity = true

<self_gravity>
units_override = true
four_pi_G      = 1.0
use_swindle    = true

<self_gravity/solver_params>
max_iterations               = 100
residual_tolerance           = 1.0e-10
absolute_residual_tolerance  = 1.0e-10
relative_residual            = true
relative_residual_tolerance  = 1.0e-8
preconditioner               = Multigrid

<parthenon/output0>
file_type = hdf5
dt        = 0.02
variables = prim, grav.phi, grav.rhs

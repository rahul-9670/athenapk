+  if (three_d) {
+    parthenon::par_for(
+        DEFAULT_LOOP_PATTERN, "CT_Poynting_X3", parthenon::DevExecSpace(), 0, nb - 1,
+        kb.s, kb.e + 1, jb.s, jb.e, ib.s, ib.e,
+        KOKKOS_LAMBDA(const int b, const int k, const int j, const int i) {
+          const Real e1 = 0.5 * (pb.flux(b, TE::E1, Bf(), k, j, i) +

-  Real eta;
-  if (use_cache) {
-    eta = 0.5 * (eta_pack(b, NonidealEtaIdx::A, k, j, i - 1) +
-                 eta_pack(b, NonidealEtaIdx::A, k, j, i));
-  } else {

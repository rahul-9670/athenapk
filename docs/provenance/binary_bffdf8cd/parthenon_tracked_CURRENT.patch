 namespace parthenon {
 
+//----------------------------------------------------------------------------------------
+int CoalescedPartitionId(MeshData<Real> *pmd) {
+  if (!pmd->grid.IsMultigrid()) return pmd->partition;
+  Mesh *pmesh = pmd->GetMeshPointer();
+  const int min_level = pmesh->GetGMGMinLevel();
+  // One slot per GMG level plus one for the (non-multigrid) leaf grid
+  const int ngrids = pmesh->GetGMGMaxLevel() - min_level + 2;
+  return pmd->partition * ngrids + (pmd->grid.multigrid_level() - min_level + 1);
+}

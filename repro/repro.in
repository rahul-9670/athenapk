<comment>
problem = Minimal multi-rank GPU Poisson divergence reproducer (issue #1400 / #1364)

<job>
problem_id = collapse_be

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.0
nlim = 3
ncycle_out = 1

<parthenon/mesh>
refinement = adaptive
numlevel = 2
multigrid = true
nx1 = 64
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -2.0
x3max = 2.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
fluid = glmmhd
eos = adiabatic
gamma = 1.4
riemann = hlld
reconstruction = plm
dfloor = 1.0e-6
pfloor = 1.0e-8

<refinement>
type = jeans
njeans = 8

<physics>
self_gravity = true

<self_gravity>
units_override = true
four_pi_G = 1.0
use_swindle = false
ix1_bc = zero
ox1_bc = zero
ix2_bc = zero
ox2_bc = zero
ix3_bc = zero
ox3_bc = zero

<self_gravity/solver_params>
solver = BiCGSTAB
max_iterations = 100
residual_tolerance = 1.0e-10
preconditioner = Multigrid
print_per_step = true

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
amp = 0.0
omegatff = 0.02
B0z = 0.15
turb_mach = 0.0

<parthenon/output0>
file_type = hst
dt = 0.001


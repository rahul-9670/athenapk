# WP-14 — order-of-accuracy on a smooth problem, in the PRODUCTION numerical configuration.
#
# WHY THIS DECK EXISTS. The stock inputs/linear_wave3d.in runs `fluid = euler` +
# `riemann = hlle`, which is NOT what production uses and therefore cannot answer WP-14.
# WP-14 asks whether the scheme AthenaPK actually runs for the FHC collapse achieves its
# formal order. So every numerical knob below is copied from runs/root_ladder/fhc_rootladder.in:
#
#   fluid = glmmhd      riemann = hlld      reconstruction = plm
#   integrator = vl2    cfl = 0.3           nghost = 2
#
# PLM + vl2 is formally 2nd order in space and time, so the acceptance target is L1 ~ h^2,
# measured as the observed order p between successive resolutions. Physics packages
# (self-gravity, radiation, non-ideal, tabulated EOS) are deliberately OFF: this measures the
# BASE hydro/MHD scheme's order, which is the thing that has never been established. Their
# individual orders are separate questions (and several are 1st-order-split by construction).
#
# The wave is a smooth eigenmode advected one full period, so the exact solution at t=tlim is
# the initial condition -- that is what makes the L1 norm in linear_wave_mhd.cpp's
# UserWorkAfterLoop an exact error rather than a difference against a finer run.

<comment>
problem = WP-14 MHD linear wave convergence, production numerics

<job>
problem_id = linear_wave_mhd

<problem/linear_wave>
compute_error = true
# wave_flag for glmmhd: 0=fast-, 1=Alfven-, 2=slow-, 3=entropy, 4=slow+, 5=Alfven+, 6=fast+.
# Overridden per leg on the command line so every family gets its own ladder.
wave_flag = 0
amp       = 1.0e-6     # small enough that the evolution stays in the linear regime
vflow     = 0.0
test      = true

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 64
x1min = 0.0
x1max = 3.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = 0.0
x2max = 1.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 32
x3min = 0.0
x3max = 1.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2        # production
cfl = 0.3               # production
tlim = 1.0
nlim = 100000
perf_cycle_offset = 2

<hydro>
fluid = glmmhd          # production
eos = adiabatic
riemann = hlld          # production
reconstruction = plm    # production
gamma = 1.666666666666667
scratch_level = 0

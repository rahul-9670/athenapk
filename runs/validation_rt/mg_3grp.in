<comment>
problem = Multigroup M1 equivalence gate: free-streaming pulse split equally across 3
# frequency groups with a nu-INDEPENDENT opacity (opacity_nu_index=0) and matter coupling
# OFF. Each group carries 1/3 of E and F with identical reduced flux, so the M1 closure is
# identical per group and sum_g E_g must track the gray (n_group=1) run cell-for-cell.
# Paired with sig_fs.in (the gray reference, same grid/pulse/tlim).

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-10
Eamp  = 1.0
x0    = 0.0
width = 0.03
reduced_flux = 1.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 256
x1min = -0.5
x1max =  0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 256
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 0.04
nlim       = 100000
ncycle_out = 50

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.6666667
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
closure = M1
reconstruction = plm
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 2.0e5
opacity_model = constant
kappa_a_code = 0.0
kappa_s_code = 0.0
matter_coupling = false
cfl = 0.3
efloor = 1.0e-20
n_group = 3
opacity_nu_index = 0.0

<parthenon/output0>
file_type = hdf5
dt        = 0.005
variables = prim, rad.Er, rad.Er_g1, rad.Er_g2, rad.Fr1, rad.Fr1_g1, rad.Fr1_g2

<parthenon/output1>
file_type = hst
dt        = 1000

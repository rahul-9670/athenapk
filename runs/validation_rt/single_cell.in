<comment>
problem = WS-2 increment 2: single-cell-in-a-box thermochemistry relaxation. Uniform gas at
# n_H~1e5, started HOT (~40 K); RT present (so rad.Er / T_dust exist) but transport+coupling are
# a no-op (RAD_DISABLE_TRANSPORT=1 env, matter_coupling off) so Er/T_dust stay fixed and ONLY the
# WS-2 Gamma-Lambda cools the gas. Gate: T relaxes to the increment-1 equilibrium T_eq(n_H) within
# 5%, no dt collapse, chem_trunc_total stays 0. E0 set so T_dust ~ 10 K (arad_code ~ 0.41).

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 0.713
p0    = 2.80
E0    = 0.41
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 8
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 8.0
nlim       = -1
ncycle_out = 50

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.6666667
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-14
nscalars       = 5

<physics>
self_gravity = false
radiation = true
chemistry = true

<radiation>
closure = M1
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 1.0e5
opacity_model = constant
kappa_a_code = 0.0
matter_coupling = false
efloor = 1.0e-20

<chemistry>
network = gow17_reduced
thermo = true
zeta_cr_cgs = 1.0e-16
x_Ctot = 1.6e-4
nsub_max = 400
cfl_cool = 0.1
thermo_nsub_max = 200
thermo_cfl = 0.1

<parthenon/output0>
file_type = hdf5
dt        = 0.5
variables = prim, rad.Er

<parthenon/output1>
file_type = hst
dt        = 0.1

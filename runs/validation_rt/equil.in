<comment>
problem = WS-3a gate (i): 0-D matter-coupling equilibration test for the Planck/Rosseland split.
# Uniform gas + uniform radiation (Eamp=0 => no transport gradients). Gas starts hotter than the
# radiation field; the emission term S_e = -c rho kappa_P (E-B) cools the gas and heats Er until
# radiative equilibrium E = B = arad T^4. Constant opacity => kappa_P = planck_ross_ratio*kappa_a0
# EXACTLY, so the emission relaxation rate scales linearly with planck_ross_ratio: ratio=2 must
# reach equilibrium ~2x faster than ratio=1, and ratio=1 must be bit-identical to the pre-split code.

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-3
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nx1 = 16
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 16
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 16
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 5.0
nlim       = -1
ncycle_out = 1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.6666667
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
closure = M1
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 1000.0
opacity_model = constant
kappa_a_code = 1.0
kappa_s_code = 0.0
planck_ross_ratio = 1.0
matter_coupling = true
cfl = 0.4
efloor = 1.0e-15
tfloor_code = 1.0e-6

<parthenon/output0>
file_type = hdf5
dt        = 0.1
variables = prim, rad.Er

<parthenon/output1>
file_type = hst
dt        = 0.02

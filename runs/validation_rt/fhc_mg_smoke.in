<comment>
problem = FHC multigroup smoke test: the real collapse_be BE-sphere collapse (glmMHD +
# self-gravity multigrid + hydrogen tabulated EOS + Bell&Lin M1 RT) at 32^3, refinement off,
# a handful of cycles, with n_group=3 band-mean multigroup radiation. Confirms the multigroup
# coupling runs with the production microphysics (hydrogen EOS + belllin opacity + MHD +
# self-gravity) and that collapse_be seeds the group fields in LTE. Chemistry + non-ideal MHD
# stripped (orthogonal to the RT multigroup path) to keep it a fast CPU smoke.

<job>
problem_id = collapse_be

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.5
nlim = 12
ncycle_out = 1

<parthenon/mesh>
refinement = none
multigrid = true
nx1 = 32
x1min = -8.0
x1max = 8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -8.0
x2max = 8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -8.0
x3max = 8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = /beegfs/u/bbg6470/athenapk/src/eos/eos_table_hires.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended
dfloor = 1.0e-6
pfloor = 1.0e-8
nscalars = 0

<physics>
self_gravity = true
radiation = true
chemistry = false

<radiation>
closure = M1
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 1000.0
opacity_model = belllin
dust_kappa0_cgs = 2.0e-4
dust_Tmax_K = 1.5e3
matter_coupling = true
cfl = 0.4
efloor = 1.0e-15
tfloor_code = 1.0e-3
n_group = 3
opacity_beta = 1.0

<self_gravity>
units_override = true
four_pi_G = 1.0
use_swindle = false
packed_bc = true
ix1_bc = multipole
ox1_bc = multipole
ix2_bc = multipole
ox2_bc = multipole
ix3_bc = multipole
ox3_bc = multipole

<self_gravity/solver_params>
solver = BiCGSTAB
max_iterations = 200
residual_tolerance = 1.0e-6
do_FAS = true
max_coarsenings = 20
smoother = SRJ1
presmoother = SRJ1
postsmoother = SRJ1
preconditioner = Multigrid

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
amp = 0.0
omegatff = 0.02
B0z = 0.15
turb_mach = 0.0
turb_alpha = 3.667
turb_seed = 42
turb_kmin = 1
turb_kmax = 8
turb_nmodes = 128
turb_zeta = 0.5
turb_region = sphere

<parthenon/output0>
file_type = hdf5
dn = 4
variables = prim, rad.Er, rad.Er_g1, rad.Er_g2
single_precision_output = 1

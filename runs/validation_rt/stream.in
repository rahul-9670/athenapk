<comment>
problem = WS-3b gate: free-streaming M1 pulse, donor-cell vs PLM. A Gaussian Er pulse with a
# fully forward-peaked flux (reduced_flux=1) advects in +x at chat on optically-thin gas
# (kappa=0, matter_coupling off). Numerical diffusion smears the front; PLM reconstruction
# (radiation/reconstruction=plm) should cut the FWHM growth by >=2x vs donor cell (dc).

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 1.0e-10
Eamp  = 1.0
x0    = -0.3
width = 0.03
reduced_flux = 1.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -0.5
x1max =  0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 1000
nlim       = 16
ncycle_out = 20

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.6666667
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
closure = M1
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 2.0e5
opacity_model = constant
kappa_a_code = 0.0
kappa_s_code = 0.0
matter_coupling = false
cfl = 0.3
efloor = 1.0e-20

<parthenon/output0>
file_type = hdf5
dt        = 0.004
variables = prim, rad.Er, rad.Fr1

<parthenon/output1>
file_type = hst
dt        = 1000

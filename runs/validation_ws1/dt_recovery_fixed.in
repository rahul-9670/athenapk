<comment>
problem = WS-1 increment 5: dt recovery past first-core via sink creation+accretion.
# BE collapse (L=16 multipole gravity, jeans AMR). rho_sink = auto Truelove (n_jeans_sink=8):
# a sink forms exactly when the finest level can no longer resolve the Jeans length, and
# accretion caps the sink-region density at rho_sink/3 -> AMR stops refining -> dt recovers.

<job>
problem_id = collapse_be

<problem/collapse_be>
mass        = 6.0
temperature = 10.0
f           = 5.0
rhocrit     = 1.0e-13
amp         = 0.0
omegatff    = 0.0

<parthenon/mesh>
refinement = adaptive
numlevel   = 6
derefine_count = 50
multigrid  = true
nx1 = 64
x1min = -8.0
x1max =  8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -8.0
x2max =  8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -8.0
x3max =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 1.5
nlim       = -1
ncycle_out = 1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-6
pfloor         = 1.0e-8

<refinement>
type   = jeans
njeans = 8

<physics>
self_gravity = true

<self_gravity>
units_override = true
four_pi_G      = 1.0
use_swindle    = false
packed_bc      = true
ix1_bc = multipole
ox1_bc = multipole
ix2_bc = multipole
ox2_bc = multipole
ix3_bc = multipole
ox3_bc = multipole

<self_gravity/solver_params>
max_iterations              = 200
residual_tolerance          = 1.0e-10
absolute_residual_tolerance = 1.0e-10
relative_residual           = true
relative_residual_tolerance = 1.0e-6
preconditioner              = Multigrid

<sinks>
enabled       = true
creation      = true
accretion     = true
gas_gravity   = true
sink_gravity  = false
soft_sink     = 0.01
rho_sink_code = 8000.0
n_jeans_sink  = 8.0
racc_cells    = 4.0
four_pi_G     = 1.0
nseed         = 0

<parthenon/output0>
file_type = hdf5
dt        = 0.02
variables = prim, grav.phi
swarms    = sinks
sinks_variables = mass, vx, vy, vz, t_created

<parthenon/output1>
file_type = hst
dt        = 0.005

<parthenon/output2>
file_type = rst
dn        = 10

<comment>
problem = WS-1 increment 1: inert sink ballistic advection + swarm migration + restart.
# Uniform gas at rest (poisson_test with radius>>box), no gravity; one sink flies in +x
# across several meshblocks. Analytic path: x=-6+2t, y=0.1, z=0.1.

<job>
problem_id = poisson_test

<problem/poisson_test>
radius   = 1.0e6
rho_in   = 1.0
rho_out  = 1.0
pressure = 1.0

<parthenon/mesh>
refinement = none
nx1 = 64
x1min = -8.0
x1max =  8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -8.0
x2max =  8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -8.0
x3max =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 5.0
nlim       = -1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm

<physics>
self_gravity = false

<sinks>
enabled   = true
seed_x    = -6.0
seed_y    = 0.1
seed_z    = 0.1
seed_vx   = 2.0
seed_vy   = 0.0
seed_vz   = 0.0
seed_mass = 1.0

<parthenon/output0>
file_type = hdf5
dt        = 1.0
variables = prim
swarms    = sinks

<parthenon/output1>
file_type = rst
dt        = 2.5

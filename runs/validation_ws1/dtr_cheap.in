<comment>
problem = WS-1 increment 5 (gate 4): dt recovery, cheap manufactured version (no self-grav).
# Gaussian peak + strong radial inflow -> central density runs away -> maxdensity AMR refines
# (dx_min shrinks -> Courant dt craters). A sink forms at rho>rho_sink=900 and accretion caps
# the density at rho_sink/3=300 (< deref_below) -> blocks derefine -> dt RECOVERS.

<job>
problem_id = poisson_test

<problem/poisson_test>
profile  = gaussian
rho_in   = 300.0
rho_out  = 1.0
sigma    = 0.6
v_radial = 1.5
pressure = 1.0

<parthenon/mesh>
refinement = adaptive
numlevel   = 6
nx1 = 32
x1min = -4.0
x1max =  4.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -4.0
x2max =  4.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -4.0
x3max =  4.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<refinement>
type = maxdensity
maxdensity_refine_above = 400.0
maxdensity_deref_below  = 350.0

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 2.0
nlim       = -1
ncycle_out = 1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-6
pfloor         = 1.0e-8

<physics>
self_gravity = false

<sinks>
enabled       = true
creation      = true
accretion     = true
gas_gravity   = false
rho_sink_code = 900.0
racc_cells    = 4.0
four_pi_G     = 12.566370614359172
nseed         = 0

<parthenon/output0>
file_type = hdf5
dt        = 0.1
variables = prim
swarms    = sinks
sinks_variables = mass, vx, vy, vz

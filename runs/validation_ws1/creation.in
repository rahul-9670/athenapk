<comment>
problem = WS-1 increment 4: sink creation at a Gaussian density peak in a converging flow.
# rho peak = 200 at center (sigma=0.8), radial inflow v=-1*r_hat (div v<0), rho_sink=100.
# Exactly one sink should form at the peak; criterion (5) forbids a second within 2*r_acc.

<job>
problem_id = poisson_test

<problem/poisson_test>
profile  = gaussian
rho_in   = 200.0
rho_out  = 1.0
sigma    = 0.8
v_radial = 1.0
pressure = 1.0

<parthenon/mesh>
refinement = none
nx1 = 32
x1min = -4.0
x1max =  4.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -4.0
x2max =  4.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -4.0
x3max =  4.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 1.0
nlim       = -1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm

<physics>
self_gravity = false

<sinks>
enabled       = true
creation      = true
gas_gravity   = false
rho_sink_code = 100.0
racc_cells    = 4.0
nseed         = 0
four_pi_G     = 12.566370614359172

<parthenon/output0>
file_type = hdf5
dt        = 0.1
variables = prim
swarms    = sinks
sinks_variables = mass, vx, vy, vz, t_created

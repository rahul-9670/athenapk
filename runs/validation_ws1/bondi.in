<comment>
problem = WS-1 increment 2: Bondi accretion onto a static sink point mass.
# Uniform gas rho=1, c_inf=1 (p=1/gamma), G=1 (four_pi_G=4pi), M=2.5 -> r_B=G M/c^2=2.5,
# sonic r_s=(5-3g)/4 r_B=0.5. Analytic Mdot_B = 4 pi lambda_c (GM)^2 rho/c^3, lambda_c(1.4)=0.625
# => Mdot_B = 4 pi * 0.625 * 6.25 = 49.087. Measure inflow flux through r=8dx=1.0.

<job>
problem_id = poisson_test

<problem/poisson_test>
radius   = 1.0e6
rho_in   = 1.0
rho_out  = 1.0
pressure = 0.7142857142857143

<parthenon/mesh>
refinement = none
nx1 = 128
x1min = -8.0
x1max =  8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 128
x2min = -8.0
x2max =  8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 128
x3min = -8.0
x3max =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 6.0
nlim       = -1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-8
pfloor         = 1.0e-8

<physics>
self_gravity = false

<sinks>
enabled    = true
four_pi_G  = 12.566370614359172
soft_cells = 1.0
seed_x     = 0.0
seed_y     = 0.0
seed_z     = 0.0
seed_vx    = 0.0
seed_vy    = 0.0
seed_vz    = 0.0
seed_mass  = 2.5

<parthenon/output0>
file_type = hdf5
dt        = 0.25
variables = prim
swarms    = sinks

<comment>
problem = Uniform-density sphere, self-gravity multipole-BC gate (WS-5a gate i)

<job>
problem_id = poisson_test

<problem/poisson_test>
radius   = 4.0
rho_in   = 1.0
rho_out  = 1.0e-8
pressure = 1.0

<parthenon/mesh>
refinement = none
multigrid  = true

# Box half-width = 8 = 2R : the stress case where zero-Dirichlet is ~10-30% off.
nx1    = 64
x1min  = -8.0
x1max  =  8.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 64
x2min  = -8.0
x2max  =  8.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 64
x3min  = -8.0
x3max  =  8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<parthenon/time>
integrator = vl2
cfl        = 1.0e-3
tlim       = 1.0e30
nlim       = 1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.4
riemann        = hllc
reconstruction = plm

<physics>
self_gravity = true

<self_gravity>
units_override = true
four_pi_G      = 1.0
use_swindle    = false
packed_bc      = false
ix1_bc         = multipole
ox1_bc         = multipole
ix2_bc         = multipole
ox2_bc         = multipole
ix3_bc         = multipole
ox3_bc         = multipole

<self_gravity/solver_params>
max_iterations               = 200
residual_tolerance           = 1.0e-12
absolute_residual_tolerance  = 1.0e-12
relative_residual            = true
relative_residual_tolerance  = 1.0e-8
preconditioner               = Multigrid

<parthenon/output0>
file_type = hdf5
dt        = 1.0e-10
variables = prim, grav.phi

<comment>
problem = M1 transport benchmark #3: 1D radiative shock (colliding flows). Two opposed
# supersonic streams (v=+-v0) collide at x=0. Absorption opacity + matter coupling => a
# radiative precursor (upstream preheat ahead of the density jump) and post-shock relaxation
# T_gas -> T_rad. arad_code=1 puts radiation & gas energy on comparable footing.

<job>
problem_id = rad_shock

<problem/rad_shock>
rho0   = 1.0
T0     = 0.2
v0     = 2.5
smooth = 0.008

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 512
x1min = -0.5
x1max =  0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 512
nx2 = 1
nx3 = 1

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 0.1
nlim       = 12
ncycle_out = 500

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.6666667
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-8
pfloor         = 1.0e-10

<physics>
self_gravity = false
radiation = true

<radiation>
closure = M1
reconstruction = plm
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 2.0e5
arad_code = 1.0
opacity_model = constant
kappa_a_code = 30.0
kappa_s_code = 0.0
matter_coupling = true
cfl = 0.3
efloor = 1.0e-30

<parthenon/output0>
file_type = hdf5
dt        = 0.01
variables = prim, rad.Er, rad.Fr1

<parthenon/output1>
file_type = hst
dt        = 1000

<parthenon/output9>
file_type = rst
dn = 6

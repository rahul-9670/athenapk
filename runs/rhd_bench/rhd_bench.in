<comment>
problem = Multigroup coupling gate (GRAY reference). Uniform gas + uniform radiation out of
# equilibrium (Er0 != arad*Tg^4), no flux, matter_coupling ON: a 0D relaxation. Compare the
# final gas T and total Er against mg_relax_mg.in (n_group=3, nu-independent) -> must match.

<job>
problem_id = rad_pulse

<problem/rad_pulse>
rho0  = 1.0
p0    = 1.0
E0    = 5.0
Eamp  = 0.0
x0    = 0.0
width = 0.05
reduced_flux = 0.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 256
x1min = -0.5
x1max =  0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = -0.5
x2max =  0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = -0.5
x3max =  0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 128
nx3 = 128

<parthenon/time>
integrator = vl2
cfl        = 0.3
tlim       = 0.03
nlim = 40
ncycle_out = 1

<hydro>
fluid          = euler
eos            = adiabatic
gamma          = 1.6666667
riemann        = hllc
reconstruction = plm
dfloor         = 1.0e-10
pfloor         = 1.0e-12

<physics>
self_gravity = false
radiation = true

<radiation>
closure = M1
reconstruction = dc
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
c_code = 100.0
creduc = 1000.0
arad_code = 1.0
opacity_model = constant
kappa_a_code = 1.0
kappa_s_code = 0.0
matter_coupling = true
cfl = 0.3
efloor = 1.0e-20
tfloor_code = 1.0e-6
inner_iteration_tol = 1.0e-10

<parthenon/output0>
file_type = hdf5
dt        = 0.03
variables = prim, rad.Er

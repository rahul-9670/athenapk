# Field-loop advection -- Constrained Transport, 3D (Phase 2, increment 3 validation).
# iprob=2 (cylinder along x1, loop in the x2-x3 plane) with the flow set diagonally in
# 3D, so all three edge EMFs E1/E2/E3 are active. Exercises the 3D GS05 kernels; absolute
# div B must stay at round-off if the E1/E2 sign/index mapping is correct.

<job>
problem_id = field_loop

<problem/field_loop>
rad        = 0.3
amp        = 1.0e-3
vflow      = 1.0
iprob      = 2

<parthenon/mesh>
refinement = none
nghost = 2

nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic

nx2 = 64
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 32
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.0
nlim = 100
perf_cycle_offset = 2

<hydro>
fluid = glmmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667
scratch_level = 0
glmmhd_source = dedner_plain
glmmhd_alpha = 0.4
divergence_control = ct
ct_emf = gs05

<parthenon/output0>
file_type = hdf5
dt = 1000.0
id = prim
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.05

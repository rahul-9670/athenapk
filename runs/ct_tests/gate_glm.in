<comment>
problem = Inc-7 flux-retention gate (GLM) -- IDEAL magnetized BE collapse, eos=hydrogen + M1 RT
# + self-gravity (multipole) + AMR. NO diffusion (ideal MHD), NO chemistry: isolates the
# divergence-control method (glm vs ct) on an otherwise production-identical collapse.
# The ONLY line that differs from gate_ct.in is <hydro> divergence_control (glm here, ct there).

<job>
problem_id = collapse_be

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.5
nlim = -1
ncycle_out = 1

<parthenon/mesh>
refinement = adaptive
numlevel = 12
derefine_count = 50
multigrid = true
nx1 = 128
x1min = -8.0
x1max = 8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 128
x2min = -8.0
x2max = 8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 128
x3min = -8.0
x3max = 8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = /beegfs/u/bbg6470/athenapk/src/eos/eos_table.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended
dfloor = 1.0e-6
pfloor = 1.0e-8
nscalars = 0
divergence_control = glm
ct_emf = gs05

<refinement>
type = jeans
njeans = 8

<physics>
self_gravity = true
radiation = true
chemistry = false

<radiation>
closure = M1
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 1000.0
opacity_model = belllin
dust_kappa0_cgs = 2.0e-4
dust_Tmax_K = 1.5e3
matter_coupling = true
cfl = 0.4
efloor = 1.0e-15
tfloor_code = 1.0e-3

<self_gravity>
units_override = true
four_pi_G = 1.0
use_swindle = false
packed_bc = true
ix1_bc = multipole
ox1_bc = multipole
ix2_bc = multipole
ox2_bc = multipole
ix3_bc = multipole
ox3_bc = multipole

<self_gravity/solver_params>
solver = BiCGSTAB
max_iterations = 200
residual_tolerance = 1.0e-6
do_FAS = true
max_coarsenings = 20
smoother = SRJ1
presmoother = SRJ1
postsmoother = SRJ1
preconditioner = Multigrid

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
amp = 0.0
B0z = 0.15

<parthenon/output0>
file_type = hst
dt = 0.005

<parthenon/output1>
file_type = hdf5
dn = 50
variables = prim, grav.phi
single_precision_output = 1
hdf5_compression_level = 0

<parthenon/output2>
file_type = rst
dn = 250

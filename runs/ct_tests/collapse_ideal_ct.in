<comment>
problem = Lean IDEAL magnetized BE collapse -- CT-vs-GLM flux-retention gate (Phase 2 inc 7).
# Ideal MHD + self-gravity (multipole BCs) + barotropic cooling + uniform B0z. NO diffusion,
# NO RT, NO chemistry -- isolates the divergence control (glm vs ct) on the magnetized
# collapse. Change ONLY <hydro> divergence_control between the matched runs.

<job>
problem_id = collapse_be

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.5
nlim = -1
ncycle_out = 20

<parthenon/mesh>
refinement = adaptive
numlevel = 8
derefine_count = 50
multigrid = true
nx1 = 64
x1min = -8.0
x1max = 8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -8.0
x2max = 8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -8.0
x3max = 8.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
fluid = glmmhd
eos = adiabatic
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended
dfloor = 1.0e-6
pfloor = 1.0e-8
divergence_control = glm
ct_emf = gs05

<refinement>
type = jeans
njeans = 8

<physics>
self_gravity = true
radiation = false
chemistry = false

<self_gravity>
units_override = true
four_pi_G = 1.0
use_swindle = false
packed_bc = true
ix1_bc = multipole
ox1_bc = multipole
ix2_bc = multipole
ox2_bc = multipole
ix3_bc = multipole
ox3_bc = multipole

<self_gravity/solver_params>
solver = BiCGSTAB
max_iterations = 200
residual_tolerance = 1.0e-6
do_FAS = true
max_coarsenings = 20
smoother = SRJ1
presmoother = SRJ1
postsmoother = SRJ1
preconditioner = Multigrid

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
B0z = 0.15

<parthenon/output0>
file_type = hdf5
dt = 0.05
id = prim
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.005

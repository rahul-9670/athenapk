<comment>
problem = AUDIT N1 -- 2D CT B_z validation base deck.
#
# WHAT THIS TESTS. Before 2026-08-05, CT in 2D never evolved B_z: E1/E2 were assembled only
# when ndim > 2 and every F3 update sat behind `if (three_d)`, so dB_z/dt = div(v_z B_pol) was
# dropped and CT_ProjectBfToCC copied the frozen face value onto cons(IB3). A guard in
# PreStepMeshUserWorkInLoop aborted rather than return that wrong answer.
#
# THE VALIDATION STRATEGY. iprob = 60 is a circularly polarized whistler eigenmode propagating
# in x, UNIFORM IN y AND z, with B_z and v_z both live -- exactly the mode the old 2D path
# froze. Because the initial condition has no z-dependence and the boundaries are periodic, the
# exact solution is z-invariant for all time. So the ALREADY-VALIDATED 3D CT path (0.4% whistler
# dispersion error, DEV_LOG) run at nx3 = 4 is a reference the 2D run must reproduce cell for
# cell. That is a stronger check than an analytic one: it exercises the ideal E1/E2 assembly,
# the F3 curl, AND the non-ideal (Ohmic/ambipolar/Hall) E1/E2 kernels against code whose 3D
# answer is independently established, with no new derivation of my own in the loop.
#
# Pre-fix this comparison could not even be run -- the 2D leg aborted on the guard.
#
# The runner (run_n1_2d.sh) overrides nx3/x3min/x3max and the physics block per leg; everything
# common lives here. dt_ceil is set on the command line so the 2D and 3D legs march on
# IDENTICAL timesteps: without it the 3D CFL sum runs over three directions and the two legs
# would drift apart at truncation-error level, blunting the test.

<job>
problem_id = diffusion

<problem/diffusion>
iprob = 60
Bx    = 1.0
By    = 0.0
amp   = 1.0e-6
nwave = 1.0
helicity = -1.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.015625
x2max = 0.015625
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.015625
x3max = 0.015625
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 4
nx3 = 4

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.02
nlim = 10000000
ncycle_out = 1000

<hydro>
fluid = glmmhd
riemann = hlld
eos = adiabatic
reconstruction = plm
gamma = 2.0
divergence_control = ct
ct_emf = gs05

<diffusion>
integrator = unsplit
cfl = 0.3
# hall_coeff_code is an INITIAL-CONDITION parameter here, not a physics switch. pgen/diffusion.cpp
# reads it unconditionally for iprob = 60 (line 126) because the whistler eigenmode's velocity
# perturbation depends on the Hall coefficient, so the deck fails to parse without it even when
# Hall evolution is off. Whether Hall actually EVOLVES is set per leg by `diffusion/hall`.
hall_coeff_code = 0.5

<parthenon/output0>
file_type = hdf5
dt = 0.02
variables = prim
id = prim

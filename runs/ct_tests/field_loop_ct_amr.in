# Field-loop advection -- Constrained Transport, STATIC AMR (Phase 2, increment 2).
# The coarse-fine boundary at x1=0 cuts straight through the loop centre, so the
# strongest field gradients sit on the C-F interface. If the edge-EMF reflux-curl
# is correct, ct_maxRelDivB stays at round-off (~1e-13); a broken shared-edge EMF
# shows an O(1e-1) spike localized at x1=0 within the first few cycles.
# Left half (x1 in [-1,0]) refined to level 1; right half stays at the root level.

<job>
problem_id = field_loop

<problem/field_loop>
rad        = 0.3
amp        = 1.0e-3
vflow      = 1.0
iprob      = 1

<parthenon/mesh>
refinement = static
numlevel = 2
nghost = 2

nx1 = 128
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 64
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 32
nx2 = 32
nx3 = 1

# Refine the left half of the domain to level 1. The C-F boundary is the vertical
# line x1 = 0, which bisects the field loop (centred at the origin, radius 0.3).
<parthenon/static_refinement0>
x1min = -1.0
x1max = 0.0
x2min = -0.5
x2max = 0.5
level = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 2.0
nlim = 200
perf_cycle_offset = 2

<hydro>
fluid = glmmhd
eos = adiabatic
riemann = hlld
reconstruction = plm
gamma = 1.666666666666667
scratch_level = 0
glmmhd_source = dedner_plain
glmmhd_alpha = 0.4
divergence_control = ct

<parthenon/output0>
file_type = hdf5
dt = 1.0
id = prim
variables = prim

<parthenon/output1>
file_type = hst
dt = 0.02

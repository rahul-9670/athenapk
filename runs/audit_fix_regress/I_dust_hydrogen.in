<comment>
problem = AUDIT round 2/3 gate -- DUST EXECUTION SMOKE (tabulated EOS).
# Written 2026-08-05. C_idealeos.in + the dust package turned on.
#
# WHY THIS DECK EXISTS: audit findings N2 (dust took its sublimation temperature from the
# ideal gamma instead of the EOS table) and N3 (dust carried a private copy of the unit
# system) both landed in src/dust/dust.cpp -- and NOT ONE deck in the 5-deck bit-identity
# suite enables <physics> dust, so neither fix had ever been EXECUTED. This deck closes that
# gap. It is an execution/None-of-it-explodes gate, NOT a bit-identity gate:
#   * N3 deliberately CHANGES the dust cgs scales (rho_unit 5.467e-19 -> 5.466828e-19, i.e.
#     +0.0031 %), so a dust-enabled run is EXPECTED to move. Bit-identity is the wrong test.
#   * What this deck does prove: Dust::Initialize's new PARTHENON_REQUIRE_THROWS on the three
#     retired <dust> keys does not misfire; BuildPhysicalUnits agrees with the BE IC here;
#     the f_dg/a_c scalar pair clears the chemistry species block (scalar_index >= NSPEC_GOW
#     = 5, nscalars = 7); and ReactDust runs to completion without NaN.
#   * eos = hydrogen, so ReactDust takes the EosTable::TemperatureK branch -- the one N2
#     actually rewrote, and the one that had never executed. Specifically at risk and tested
#     here: the eint <= 0 guard (the table interpolates in log10(eint/rho) and returns NaN
#     below zero) and the T floor. A NaN in the dust scalars, or a non-zero exit, fails this
#     gate. The ideal branch is covered by H_dust_ideal.in.

<job>
problem_id = collapse_be

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.5
nlim = 12
ncycle_out = 1

<parthenon/mesh>
refinement = adaptive
numlevel = 2
multigrid = true
nx1 = 32
x1min = -26.0
x1max = 26.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -26.0
x2max = 26.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -26.0
x3max = 26.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
fluid = glmmhd
eos = hydrogen
eos_table_file = /beegfs/u/bbg6470/athenapk/src/eos/eos_table.bin
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended
dfloor = 1.0e-6
pfloor = 1.0e-8
nscalars = 7

<refinement>
type = jeans
njeans = 8

<diffusion>
integrator = unsplit
cfl = 0.3
ambipolar = ambipolar
ambipolar_coeff = ionization
resistivity = ohmic
resistivity_coeff = ionization
hall = hall
hall_coeff = ionization
hall_ohmic_floor_code = 0.05

<physics>
self_gravity = true
radiation = true
chemistry = true
dust = true

<dust>
# scalar_index must be >= NSPEC_GOW (=5) or f_dg/a_c alias onto the chemistry species --
# guarded in Dust::Initialize since the 2026-07-18 F3 fix. nscalars = 7 = 5 species + 2 dust.
evolve = true
scalar_index = 5
# NOTE: rho_unit_cgs / t_unit_cgs / T_unit_K are deliberately ABSENT. As of audit N3 they are
# REJECTED (PARTHENON_REQUIRE_THROWS) -- the dust cgs scales come from the one authoritative
# unit system. Adding any of them back must make this deck fail to start; that is the point.

<chemistry>
network = gow17_reduced
nsub_max = 400
cfl_cool = 0.1

<radiation>
closure = M1
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 1000.0
opacity_model = belllin
matter_coupling = true
cfl = 0.4
efloor = 1.0e-15
tfloor_code = 1.0e-3

<self_gravity>
units_override = true
four_pi_G = 1.0
use_swindle = false
packed_bc = true
ix1_bc = multipole
ox1_bc = multipole
ix2_bc = multipole
ox2_bc = multipole
ix3_bc = multipole
ox3_bc = multipole

<self_gravity/solver_params>
solver = BiCGSTAB
max_iterations = 200
residual_tolerance = 1.0e-6
do_FAS = true
max_coarsenings = 20
smoother = SRJ1
presmoother = SRJ1
postsmoother = SRJ1
preconditioner = Multigrid

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
amp = 0.0
omegatff = 0.02
B0z = 0.15
turb_mach = 0.5
turb_alpha = 3.667
turb_seed = 42
turb_kmin = 1
turb_kmax = 8
turb_nmodes = 128
turb_zeta = 0.5
turb_region = sphere

<parthenon/output0>
file_type = hst
dt = 0.005

<parthenon/output1>
file_type = hdf5
dn = 100000
variables = prim, grav.phi, rad.Er
single_precision_output = 0
hdf5_compression_level = 0

<parthenon/output2>
file_type = rst
dn = 6

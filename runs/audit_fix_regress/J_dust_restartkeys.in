<comment>
problem = AUDIT N3 RESTART-KEY GATE -- the three retired <dust> unit keys must be IGNORED
# WITH A WARNING, not aborted on.
#
# WHY. `GetOrAddReal` injects its default into the ParameterInput, and Parthenon dumps the
# resulting parameter list into every restart file. So a restart written by any PRE-N3 binary
# with dust active carries `<dust> rho_unit_cgs = 5.467e-19  # Default value added at run
# time`, and on restart that key EXISTS. The original N3 guard was a PARTHENON_REQUIRE_THROWS
# aimed at DECKS; on 2026-08-06 it killed D1 probe job 2461421 in 9 s (both legs) restarting
# from runs/deep_amr/run/parthenon.out2.00001.rhdf. Left as a REQUIRE it would make every
# historical dust restart -- the flagship chain included -- unloadable by any post-N3 binary.
#
# THIS DECK reproduces that exact condition from a plain input file, which is cheap and needs
# no 6 GB restart: it is H_dust_ideal.in with the three keys written into <dust> at the values
# a pre-N3 binary would have injected. Pre-fix it aborts at parse. Post-fix it must run to
# completion, print one "### WARNING Dust:" line per key, and -- the part that actually
# matters -- produce output BIT-IDENTICAL to H_dust_ideal, proving the keys are ignored rather
# than honoured.
<job>
problem_id = collapse_be

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 1.5
nlim = 12
ncycle_out = 1

<parthenon/mesh>
refinement = adaptive
numlevel = 2
multigrid = true
nx1 = 32
x1min = -26.0
x1max = 26.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -26.0
x2max = 26.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -26.0
x3max = 26.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
fluid = glmmhd
eos = adiabatic
# eos_table_file omitted: ideal-gamma path (A1 Gate A, must stay bit-identical)
gamma = 1.4
riemann = hlld
reconstruction = plm
glmmhd_source = dedner_extended
dfloor = 1.0e-6
pfloor = 1.0e-8
nscalars = 7

<refinement>
type = jeans
njeans = 8

<diffusion>
integrator = unsplit
cfl = 0.3
ambipolar = ambipolar
ambipolar_coeff = ionization
resistivity = ohmic
resistivity_coeff = ionization
hall = hall
hall_coeff = ionization
hall_ohmic_floor_code = 0.05

<physics>
self_gravity = true
radiation = true
chemistry = true
dust = true

<dust>
# The three retired keys, at the values a pre-N3 binary injected as GetOrAdd defaults.
rho_unit_cgs = 5.4670000000000005e-19
t_unit_cgs   = 1476998822551
T_unit_K     = 10.015000000000001
# scalar_index must be >= NSPEC_GOW (=5) or f_dg/a_c alias onto the chemistry species --
# guarded in Dust::Initialize since the 2026-07-18 F3 fix. nscalars = 7 = 5 species + 2 dust.
evolve = true
scalar_index = 5
# NOTE: rho_unit_cgs / t_unit_cgs / T_unit_K are deliberately ABSENT. As of audit N3 they are
# REJECTED (PARTHENON_REQUIRE_THROWS) -- the dust cgs scales come from the one authoritative
# unit system. Adding any of them back must make this deck fail to start; that is the point.

<chemistry>
network = gow17_reduced
nsub_max = 400
cfl_cool = 0.1

<radiation>
closure = M1
mu = 2.33
rho_unit_cgs = 5.467e-19
v_unit_cgs = 1.9e4
length_unit_cgs = 2.81e16
creduc = 1000.0
opacity_model = belllin
matter_coupling = true
cfl = 0.4
efloor = 1.0e-15
tfloor_code = 1.0e-3

<self_gravity>
units_override = true
four_pi_G = 1.0
use_swindle = false
packed_bc = true
ix1_bc = multipole
ox1_bc = multipole
ix2_bc = multipole
ox2_bc = multipole
ix3_bc = multipole
ox3_bc = multipole

<self_gravity/solver_params>
solver = BiCGSTAB
max_iterations = 200
residual_tolerance = 1.0e-6
do_FAS = true
max_coarsenings = 20
smoother = SRJ1
presmoother = SRJ1
postsmoother = SRJ1
preconditioner = Multigrid

<problem/collapse_be>
mass = 6.0
temperature = 10.0
f = 5.0
rhocrit = 1.0e-13
amp = 0.0
omegatff = 0.02
B0z = 0.15
turb_mach = 0.5
turb_alpha = 3.667
turb_seed = 42
turb_kmin = 1
turb_kmax = 8
turb_nmodes = 128
turb_zeta = 0.5
turb_region = sphere

<parthenon/output0>
file_type = hst
dt = 0.005

<parthenon/output1>
file_type = hdf5
dn = 100000
variables = prim, grav.phi, rad.Er
single_precision_output = 0
hdf5_compression_level = 0

<parthenon/output2>
file_type = rst
dn = 6

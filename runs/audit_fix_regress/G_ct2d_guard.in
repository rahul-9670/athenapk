<comment>
problem = AUDIT N1 -- hall_whistler_ct.in forced to 2D (nx3 = 1).
#
# 2026-08-05: THE EXPECTED RESULT OF THIS DECK HAS CHANGED. Read this before using it.
#
# History. An iprob=60 whistler sets B_z = h*amp*sin(kx) != 0, and 2D CT used never to evolve
# B_z (E1/E2 assembled only when ndim > 2, every F3 update behind `if (three_d)`), so the mode
# silently returned zero Hall evolution in B_z and reported a bogus dispersion error. Round 2
# of the audit made that ABORT: this deck was the positive test for the guard.
#
# Now. B_z IS evolved in 2D (audit N1 fixed 2026-08-05: 2D E1/E2 for the ideal Balsara-Spicer
# and GS05 assemblers and for all three non-ideal edge EMFs; F3 updates gated on ndim > 1).
# So this deck RUNS TO COMPLETION and its answer is meaningful, where before the guard it ran
# to completion and LIED.
#
# EXPECTED RESULT: completes; the log carries the one-shot line
#   "## CT 2D out-of-plane check (audit N1): max(|B_z|,|v_z|) = ...  -> out-of-plane ...
#    B_z is EVOLVED in 2D"
# with a NON-ZERO value. An abort here means the N1 fix was reverted; a ZERO value means the
# deck stopped exercising the out-of-plane path and is no longer testing anything.
#
# The quantitative check is NOT here -- it is runs/ct_tests/n1_2d/, which runs this same
# eigenmode in 2D and in 3D and requires them to agree cell for cell against the already-
# validated 3D CT path, with a falsifier that fails if B_z has not moved.
# The paired negative test is runs/ct_tests/field_loop_ct.in -- also 2D CT, but B_z = v_z = 0,
# so the closed in-plane invariant holds and the deck is bit-identical across the fix.

<job>
problem_id = diffusion

<problem/diffusion>
iprob = 60
Bx    = 1.0
By    = 0.0
amp   = 1.0e-6
nwave = 1.0
helicity = -1.0

<parthenon/mesh>
refinement = none
nghost = 2
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.015625
x2max = 0.015625
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.015625
x3max = 0.015625
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 128
nx2 = 4
nx3 = 1

<parthenon/time>
integrator = vl2
cfl = 0.3
tlim = 0.05
nlim = 2
ncycle_out = 500

<hydro>
fluid = glmmhd
riemann = hlld
eos = adiabatic
reconstruction = plm
gamma = 2.0
divergence_control = ct
ct_emf = gs05

<diffusion>
integrator = unsplit
cfl = 0.3
hall = hall
hall_coeff = fixed
hall_coeff_code = 0.5
hall_ohmic_floor_code = 0.05

<parthenon/output0>
file_type = hdf5
dt = 0.05
variables = prim
id = prim

<parthenon/output1>
file_type = hst
dt = 0.0025
